# ==========================================
# Dependencies
# ==========================================
node_modules/
*/node_modules/
jspm_packages/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions

# ==========================================
# Environment Variables & Secrets
# ==========================================
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12

# Explicitly track example files
!.env.example
!*/.env.example

# ==========================================
# Build Artifacts & Compiled Code
# ==========================================
dist/
*/dist/
dist-ssr/
build/
*/build/
out/
.next/
.nuxt/
.output/
.cache/
.parcel-cache/
*.tsbuildinfo
vite.config.js.timestamp-*
vite.config.ts.timestamp-*
.vite/

# ==========================================
# User Uploads & Media Files
# (Ignore uploaded content, preserve directories)
# ==========================================
uploads/*
!uploads/.gitkeep
**/uploads/*
!**/uploads/.gitkeep
uploads/screenshots/*
!uploads/screenshots/.gitkeep
**/uploads/screenshots/*
!**/uploads/screenshots/.gitkeep

# ==========================================
# Logs & Runtime Data
# ==========================================
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json
*.pid
*.seed
*.pid.lock

# ==========================================
# Testing & Coverage
# ==========================================
coverage/
*.lcov
.nyc_output/

# ==========================================
# IDE & Code Editors
# ==========================================
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.sublime-project
*.sublime-workspace

# ==========================================
# Operating System Files
# ==========================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ==========================================
# Temporary Files
# ==========================================
tmp/
temp/
*.tmp
*.bak
